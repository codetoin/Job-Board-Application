<%- include("partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100">

  <!-- Header -->
  <%- include("partials/header.ejs") %>

  <div class="min-h-screen flex">

    <!-- Sidebar for logged-in users -->
    <% if (user && ["jobseeker", "employer", "admin"].includes(user.role)) { %>
      <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
        <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
        <nav class="flex flex-col gap-4 text-gray-200">
          <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>

          <% if(user.role === "admin") { %>
            <%- include("partials/sidebars/admin.ejs") %>
          <% } else if(user.role === "employer") { %>
            <%- include("partials/sidebars/employer.ejs") %>
          <% } else if(user.role === "jobseeker") { %>
            <%- include("partials/sidebars/jobseeker.ejs") %>
          <% } %>
        </nav>
      </aside>
    <% } %>

    <!-- Main Content + Footer wrapper -->
    <div class="flex-1 flex flex-col <%= user && ["jobseeker","employer","admin"].includes(user.role) ? 'md:ml-64' : '' %> min-h-screen">

      <!-- Main Content -->
      <main class="flex-grow p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">

        <!-- Hero Section -->
        <section class="bg-indigo-700 text-white rounded-3xl p-10 md:p-16 shadow-xl text-center relative overflow-hidden">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-6 tracking-tight">About Our Job Portal</h1>
          <p class="text-base md:text-lg max-w-3xl mx-auto mb-6 leading-relaxed">
            Connecting talented individuals with top companies worldwide. Our platform makes job searching, applying, and career growth simple, fast, and professional.
          </p>
          <div class="absolute -bottom-12 -right-12 w-32 h-32 md:w-40 md:h-40 bg-indigo-500 rounded-full opacity-30 animate-pulse"></div>
          <div class="absolute -top-12 -left-12 w-24 h-24 md:w-32 md:h-32 bg-indigo-600 rounded-full opacity-20 animate-pulse"></div>
        </section>

        <!-- Mission & Vision -->
        <section class="bg-gray-800 rounded-3xl shadow-lg p-8 md:p-12 flex flex-col md:flex-row items-center gap-10 md:gap-16 flex-wrap relative overflow-hidden">
          <div class="flex-1 min-w-[280px] max-w-lg">
            <h2 class="text-2xl md:text-3xl font-bold mb-3 text-indigo-400">Our Mission</h2>
            <p class="text-gray-200 mb-6 text-base md:text-lg leading-relaxed">
              Empower job seekers with tools, resources, and opportunities to build fulfilling careers while helping companies find the right talent.
            </p>

            <h2 class="text-2xl md:text-3xl font-bold mb-3 text-indigo-400">Our Vision</h2>
            <p class="text-gray-200 text-base md:text-lg leading-relaxed">
              Become the most trusted and user-friendly job platform, connecting people and organizations across industries and borders.
            </p>
          </div>

          <div class="flex-1 min-w-[150px] text-indigo-400 text-7xl md:text-8xl lg:text-9xl flex justify-center md:justify-end animate-bounce">
            🌐
          </div>
        </section>

        <!-- Core Values -->
        <section class="bg-gray-900 rounded-3xl p-8 md:p-12 space-y-12">
          <h2 class="text-2xl md:text-4xl font-extrabold mb-8 text-indigo-400 text-center tracking-wide">Our Core Values</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-gray-200 text-center">
            <div class="p-4 hover:bg-gray-800 rounded-2xl transition">
              <div class="text-indigo-400 text-5xl mb-3 animate-pulse">🤝</div>
              <h3 class="text-xl font-semibold mb-2">Integrity</h3>
              <p class="text-sm md:text-base leading-relaxed">Transparency, honesty, and professionalism in every interaction.</p>
            </div>
            <div class="p-4 hover:bg-gray-800 rounded-2xl transition">
              <div class="text-indigo-400 text-5xl mb-3 animate-pulse">🚀</div>
              <h3 class="text-xl font-semibold mb-2">Innovation</h3>
              <p class="text-sm md:text-base leading-relaxed">Continuously improving our platform for the best user experience.</p>
            </div>
            <div class="p-4 hover:bg-gray-800 rounded-2xl transition">
              <div class="text-indigo-400 text-5xl mb-3 animate-pulse">🌟</div>
              <h3 class="text-xl font-semibold mb-2">Excellence</h3>
              <p class="text-sm md:text-base leading-relaxed">High-quality services that help users and companies achieve their goals.</p>
            </div>
          </div>
        </section>

        <!-- Technologies Used -->
        <section class="bg-gray-800 rounded-3xl p-8 md:p-12">
          <h2 class="text-3xl md:text-4xl font-extrabold mb-8 text-indigo-400 text-center tracking-wide">Technologies We Use</h2>
          <div class="flex flex-wrap justify-center gap-12 text-gray-200 mt-6">
            <div class="flex flex-col items-center min-w-[100px] hover:scale-105 transform transition">
              <div class="text-5xl mb-2 animate-bounce">🟢</div>
              <span class="font-medium">Node.js</span>
            </div>
            <div class="flex flex-col items-center min-w-[100px] hover:scale-105 transform transition">
              <div class="text-5xl mb-2 animate-bounce">🚂</div>
              <span class="font-medium">Express.js</span>
            </div>
            <div class="flex flex-col items-center min-w-[100px] hover:scale-105 transform transition">
              <div class="text-5xl mb-2 animate-bounce">🐘</div>
              <span class="font-medium">PostgreSQL</span>
            </div>
            <div class="flex flex-col items-center min-w-[100px] hover:scale-105 transform transition">
              <div class="text-5xl mb-2 animate-bounce">🎨</div>
              <span class="font-medium">Tailwind CSS</span>
            </div>
            <div class="flex flex-col items-center min-w-[100px] hover:scale-105 transform transition">
              <div class="text-5xl mb-2 animate-bounce">📄</div>
              <span class="font-medium">EJS</span>
            </div>
          </div>
        </section>

      </main>

      <!-- Footer -->
      <%- include("partials/footer.ejs") %>

    </div>
  </div>

</body>
</html>
