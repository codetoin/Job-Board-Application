<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <%- include("../partials/header.ejs") %>

  <!-- Content Wrapper -->
  <div class="flex flex-1 min-h-screen">

    <!-- Sidebar -->
    <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
      <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
      <nav class="flex flex-col gap-4 text-gray-200">
        <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>
        <%- include("../partials/sidebars/jobseeker.ejs") %>
      </nav>
    </aside>

    <!-- Main Content + Footer wrapper -->
    <div class="flex-1 flex flex-col md:ml-64">

      <!-- Main -->
      <main class="flex-grow p-6 md:p-10 space-y-10 overflow-x-hidden">

        <div class="max-w-3xl mx-auto space-y-10">

          <!-- Page Title -->
          <div class="border-b border-gray-700 pb-4">
            <h2 class="text-2xl font-bold text-indigo-400">
              My Profile
            </h2>
          </div>

          <!-- Form -->
          <form
            action="/jobseeker/profile/edit"
            method="POST"
            enctype="multipart/form-data"
            class="space-y-6"
          >
            <!-- Name -->
            <div class="space-y-1">
              <label for="name" class="text-sm text-gray-300">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                value="<%= user.name %>"
                required
                class="w-full px-4 py-2 bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-indigo-500"
              />
            </div>

            <!-- Experience -->
            <div class="space-y-1">
              <label class="text-sm text-gray-300">Experience</label>
              <select
                name="experience"
                required
                class="w-full px-4 py-2 bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-indigo-500"
              >
                <option value="">Select Experience Level</option>
                <option value="Junior" <%= userProfile?.experience === 'Junior' ? 'selected' : '' %>>Junior</option>
                <option value="Mid" <%= userProfile?.experience === 'Mid' ? 'selected' : '' %>>Mid</option>
                <option value="Senior" <%= userProfile?.experience === 'Senior' ? 'selected' : '' %>>Senior</option>
              </select>
            </div>

            <!-- Skills -->
            <div class="space-y-1">
              <label class="text-sm text-gray-300">Skills</label>
              <input
                type="text"
                name="skills"
                placeholder="HTML, CSS, JavaScript"
                value="<%= user.skills || '' %>"
                required
                class="w-full px-4 py-2 bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-indigo-500"
              />
            </div>

            <!-- Resume Upload -->
            <div class="space-y-2">
              <label class="text-sm text-gray-300">Upload Resume (PDF)</label>
              <input
                type="file"
                name="resume"
                accept=".pdf"
                class="block w-full text-sm text-gray-400"
              />

              <% if (userProfile?.resume_url) { %>
                <p class="text-sm text-gray-400">
                  Current Resume:
                  <a
                    href="<%= userProfile.resume_url %>"
                    target="_blank"
                    class="text-indigo-400 hover:underline"
                  >
                    View Resume
                  </a>
                </p>
              <% } %>
            </div>

            <!-- Profile Photo -->
            <div class="space-y-2">
              <label class="text-sm text-gray-300">Upload Profile Photo</label>
              <input
                type="file"
                name="image"
                accept="image/png, image/jpeg"
                class="block w-full text-sm text-gray-400"
              />

              <% if (userProfile?.image_url) { %>
                <div class="mt-2">
                  <p class="text-sm text-gray-400 mb-2">Current Photo:</p>
                  <img
                    src="<%= userProfile.image_url %>"
                    alt="Profile Photo"
                    class="w-28 h-28 object-cover rounded border border-gray-600"
                  />
                </div>
              <% } %>
            </div>

            <!-- Bio -->
            <div class="space-y-1">
              <label for="bio" class="text-sm text-gray-300">Bio</label>
              <textarea
                name="bio"
                id="bio"
                rows="5"
                placeholder="Tell us about yourself..."
                class="w-full px-4 py-2 bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-indigo-500"
              ><%= userProfile?.bio || '' %></textarea>
            </div>

            <!-- Submit & Cancel -->
            <div class="pt-4 border-t border-gray-700 flex gap-4 justify-end">
              <button
                type="submit"
                class="px-6 py-2 border border-indigo-500 text-indigo-400 hover:bg-indigo-600 hover:text-white transition"
              >
                Save Profile
              </button>
              <a
                href="/jobseeker/profile"
                class="px-6 py-2 border border-red-500 text-red-400 hover:bg-red-600 hover:text-white rounded transition text-center"
              >
                Cancel
              </a>
            </div>

          </form>
        </div>

      </main>

      <!-- Footer -->
      <%- include("../partials/footer.ejs") %>

    </div>
  </div>

</body>
</html>
