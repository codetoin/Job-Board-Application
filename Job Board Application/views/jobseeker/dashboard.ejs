<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <%- include("../partials/header.ejs") %>

  <!-- Content Wrapper -->
  <div class="flex flex-1 min-h-screen">

    <!-- Sidebar -->
    <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
      <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
      <nav class="flex flex-col gap-4 text-gray-200">
        <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>
        <%- include("../partials/sidebars/jobseeker.ejs") %>
      </nav>
    </aside>

    <!-- Main Content + Footer wrapper -->
    <div class="flex-1 flex flex-col md:ml-64">

      <!-- Main -->
      <main class="flex-grow p-6 md:p-10 space-y-10 overflow-x-hidden">

        <!-- Welcome -->
        <h2 class="text-3xl font-extrabold text-indigo-400">
          Welcome, <%= user.name %>!
        </h2>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <div class="bg-gray-800 rounded-xl p-6 text-center shadow-lg">
            <h3 class="text-lg font-semibold text-gray-300">Total Applied</h3>
            <p class="text-3xl font-bold text-indigo-400 mt-2"><%= stats.total %></p>
          </div>

          <div class="bg-gray-800 rounded-xl p-6 text-center shadow-lg">
            <h3 class="text-lg font-semibold text-gray-300">Pending</h3>
            <p class="text-3xl font-bold text-yellow-400 mt-2"><%= stats.pending %></p>
          </div>

          <div class="bg-gray-800 rounded-xl p-6 text-center shadow-lg">
            <h3 class="text-lg font-semibold text-gray-300">Accepted</h3>
            <p class="text-3xl font-bold text-green-400 mt-2"><%= stats.accepted %></p>
          </div>

        </div>

        <!-- Recent Applications -->
        <div class="bg-gray-800 rounded-xl p-6 shadow-lg space-y-4">

          <h3 class="text-xl font-bold text-indigo-400">Recent Applications</h3>

          <% if (recentApplications.length === 0) { %>
            <p class="text-gray-400">You haven't applied to any jobs yet.</p>
          <% } else { %>

            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="text-left text-gray-300 border-b border-gray-700">
                    <th class="py-3 px-2">Job Title</th>
                    <th class="py-3 px-2">Company</th>
                    <th class="py-3 px-2">Status</th>
                    <th class="py-3 px-2">Applied On</th>
                  </tr>
                </thead>
                <tbody>

                  <% recentApplications.forEach(app => { %>
                    <tr class="border-b border-gray-700 hover:bg-gray-700 transition">
                      <td class="py-3 px-2"><%= app.job_title %></td>
                      <td class="py-3 px-2"><%= app.company_name %></td>
                      <td class="py-3 px-2 font-semibold"><%= app.status %></td>
                      <td class="py-3 px-2">
                        <%= new Date(app.created_at).toLocaleDateString() %>
                      </td>
                    </tr>
                  <% }) %>

                </tbody>
              </table>
            </div>

          <% } %>
        </div>

      </main>

      <!-- Footer -->
      <%- include("../partials/footer.ejs") %>

    </div>
  </div>

</body>
</html>
