<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <%- include("../partials/header.ejs") %>

  <!-- Content Wrapper -->
  <div class="flex flex-1 min-h-screen">

    <!-- Sidebar -->
    <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
      <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
      <nav class="flex flex-col gap-4 text-gray-200">
        <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>
        <%- include("../partials/sidebars/jobseeker.ejs") %>
      </nav>
    </aside>

    <!-- Main Content + Footer wrapper -->
    <div class="flex-1 flex flex-col md:ml-64">

      <!-- Main -->
      <main class="flex-grow p-6 md:p-10 space-y-10 overflow-x-hidden">

        <div class="max-w-7xl mx-auto space-y-6">

          <h2 class="text-3xl font-bold text-indigo-400">Saved Jobs</h2>

          <% if (savedJobs.length === 0) { %>
            <p class="text-gray-400">You haven't saved any jobs yet.</p>
          <% } else { %>

            <div class="overflow-x-auto bg-gray-800 rounded-xl shadow-lg">
              <table class="w-full text-sm border-collapse">
                <thead class="bg-gray-700 text-gray-300">
                  <tr>
                    <th class="px-4 py-3 text-left">Job Title</th>
                    <th class="px-4 py-3 text-left">Company</th>
                    <th class="px-4 py-3 text-left">Location</th>
                    <th class="px-4 py-3 text-left">Type</th>
                    <th class="px-4 py-3 text-left">Salary</th>
                    <th class="px-4 py-3 text-left">Category</th>
                    <th class="px-4 py-3 text-left">Experience</th>
                    <th class="px-4 py-3 text-left">Remote</th>
                    <th class="px-4 py-3 text-left">Active</th>
                    <th class="px-4 py-3 text-left">Actions</th>
                  </tr>
                </thead>

                <tbody class="divide-y divide-gray-700">

                  <% savedJobs.forEach(job => { %>
                    <tr class="hover:bg-gray-700 transition">
                      <td class="px-4 py-3"><%= job.title %></td>
                      <td class="px-4 py-3"><%= job.company_name %></td>
                      <td class="px-4 py-3"><%= job.location %></td>
                      <td class="px-4 py-3"><%= job.job_type %></td>
                      <td class="px-4 py-3"><%= job.salary %></td>
                      <td class="px-4 py-3"><%= job.category_name %></td>
                      <td class="px-4 py-3"><%= job.experience_level %></td>
                      <td class="px-4 py-3"><%= job.remote ? "Yes" : "No" %></td>
                      <td class="px-4 py-3"><%= job.is_active ? "Yes" : "No" %></td>

                      <td class="px-4 py-3 flex flex-col gap-2">

                        <!-- Apply -->
                        <% if (appliedJobs.includes(job.id)) { %>
                          <button
                            disabled
                            class="px-3 py-1 rounded bg-gray-500 text-gray-200 cursor-not-allowed text-xs"
                          >
                            Already Applied
                          </button>
                        <% } else { %>
                          <form action="/applications/apply/<%= job.id %>" method="POST">
                            <button
                              type="submit"
                              class="px-3 py-1 rounded bg-green-600 hover:bg-green-700 text-white text-xs transition"
                            >
                              Apply
                            </button>
                          </form>
                        <% } %>

                        <!-- Remove -->
                        <form action="/saved/remove/<%= job.id %>" method="POST">
                          <button
                            type="submit"
                            class="px-3 py-1 rounded bg-red-600 hover:bg-red-700 text-white text-xs transition"
                          >
                            Remove
                          </button>
                        </form>

                      </td>
                    </tr>
                  <% }) %>

                </tbody>
              </table>
            </div>

          <% } %>

        </div>

      </main>

      <!-- Footer -->
      <%- include("../partials/footer.ejs") %>

    </div>
  </div>

</body>
</html>
