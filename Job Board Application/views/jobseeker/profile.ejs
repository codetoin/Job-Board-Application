<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <%- include("../partials/header.ejs") %>

  <!-- Content Wrapper -->
  <div class="flex flex-1 min-h-screen">

    <!-- Sidebar -->
    <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
      <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
      <nav class="flex flex-col gap-4 text-gray-200">
        <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>
        <%- include("../partials/sidebars/jobseeker.ejs") %>
      </nav>
    </aside>

    <!-- Main Content + Footer wrapper -->
    <div class="flex-1 flex flex-col md:ml-64">

      <!-- Main -->
      <main class="flex-grow px-8 py-10">

        <div class="max-w-4xl mx-auto space-y-12">

          <!-- Profile Header -->
          <section class="flex items-center gap-6 pb-6 border-b border-gray-700">
            <img
              src="<%= user.image_url || '/default-avatar.png' %>"
              alt="Profile Pic"
              class="w-24 h-24 rounded-full object-cover border border-gray-600"
            />
            <div>
              <h1 class="text-3xl font-bold text-indigo-400">
                <%= user.name %>
              </h1>
              <% if(user.email) { %>
                <p class="text-gray-400 mt-1">
                  <%= user.email %>
                </p>
              <% } %>
            </div>
          </section>

          <!-- About -->
          <section class="space-y-2">
            <h2 class="text-lg font-semibold text-indigo-400">About</h2>
            <p class="text-gray-300 leading-relaxed">
              <%= user.bio || 'No bio added yet.' %>
            </p>
          </section>

          <!-- Skills -->
          <section class="space-y-3">
            <h2 class="text-lg font-semibold text-indigo-400">Skills</h2>
            <% if (skills && skills.length > 0) { %>
              <div class="flex flex-wrap gap-3">
                <% skills.forEach(skill => { %>
                  <span class="text-sm px-3 py-1 border border-gray-600 rounded">
                    <%= skill %>
                  </span>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-gray-400">No skills added yet.</p>
            <% } %>
          </section>

          <!-- Resume -->
          <section class="space-y-2">
            <h2 class="text-lg font-semibold text-indigo-400">Resume</h2>
            <% if (user.resume_url) { %>
              <p class="text-green-400">Resume uploaded</p>
              <a
                href="<%= user.resume_url %>"
                target="_blank"
                class="text-indigo-400 hover:underline inline-block"
              >
                View Resume
              </a>
            <% } else { %>
              <p class="text-gray-400">No resume uploaded.</p>
              <a
                href="/jobseeker/profile/edit"
                class="text-indigo-400 hover:underline inline-block"
              >
                Upload Resume
              </a>
            <% } %>
          </section>

          <!-- Action -->
          <div class="pt-6 border-t border-gray-700 flex justify-end">
            <a
              href="/jobseeker/profile/edit"
              class="px-6 py-2 border border-indigo-500 text-indigo-400 hover:bg-indigo-500 hover:text-white transition"
            >
              Edit Profile
            </a>
          </div>

        </div>
      </main>

      <!-- Footer -->
      <%- include("../partials/footer.ejs") %>

    </div>
  </div>

</body>
</html>
