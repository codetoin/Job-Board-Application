<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

<%- include("../partials/header.ejs") %>

<div class="flex flex-1 min-h-screen">

  <!-- Sidebar -->
  <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
    <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
    <nav class="flex flex-col gap-4 text-gray-200">
      <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>
      <%- include("../partials/sidebars/employer.ejs") %>
    </nav>
  </aside>

  <!-- Main Content + Footer wrapper -->
  <div class="flex-1 flex flex-col md:ml-64 min-h-screen">

    <!-- Main Content -->
    <main class="flex-grow flex flex-col p-6 md:p-10 space-y-10">

      <h2 class="text-2xl font-bold text-indigo-400 mb-6">Edit Company Profile</h2>

      <form action="/employer/profile/edit" method="POST" class="bg-gray-800 p-6 rounded-lg shadow-md space-y-4">

        <!-- Company Name -->
        <div>
          <label class="block mb-1 font-semibold">Company Name</label>
          <input
            type="text"
            name="name"
            class="w-full px-3 py-2 rounded bg-gray-900 border border-gray-700 focus:outline-none focus:border-indigo-400"
            value="<%= company.name %>"
            required
          />
        </div>

        <!-- Email -->
        <div>
          <label class="block mb-1 font-semibold">Company Email</label>
          <input
            type="email"
            name="email"
            class="w-full px-3 py-2 rounded bg-gray-900 border border-gray-700 focus:outline-none focus:border-indigo-400"
            value="<%= company.email %>"
            required
          />
        </div>

        <!-- Phone -->
        <div>
          <label class="block mb-1 font-semibold">Phone</label>
          <input
            type="text"
            name="phone"
            class="w-full px-3 py-2 rounded bg-gray-900 border border-gray-700 focus:outline-none focus:border-indigo-400"
            value="<%= company.phone || '' %>"
          />
        </div>

        <!-- Website -->
        <div>
          <label class="block mb-1 font-semibold">Website</label>
          <input
            type="url"
            name="website"
            class="w-full px-3 py-2 rounded bg-gray-900 border border-gray-700 focus:outline-none focus:border-indigo-400"
            value="<%= company.website || '' %>"
          />
        </div>

        <!-- Description -->
        <div>
          <label class="block mb-1 font-semibold">Company Description</label>
          <textarea
            name="description"
            rows="4"
            class="w-full px-3 py-2 rounded bg-gray-900 border border-gray-700 focus:outline-none focus:border-indigo-400"
          ><%= company.description || '' %></textarea>
        </div>

        <!-- Buttons -->
        <div class="flex gap-3 mt-4">
          <button type="submit" class="bg-green-500 hover:bg-green-600 px-4 py-2 rounded text-white font-semibold transition">
            Save Changes
          </button>
          <a href="/employer/company/profile" class="bg-gray-600 hover:bg-gray-700 px-4 py-2 rounded text-white font-semibold transition">
            Cancel
          </a>
        </div>

      </form>

    </main>

    <!-- Footer -->
    <%- include("../partials/footer.ejs") %>

  </div>
</div>

</body>
</html>
