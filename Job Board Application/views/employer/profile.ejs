<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

<%- include("../partials/header.ejs") %>

<div class="flex flex-1 min-h-screen">

  <!-- Sidebar -->
  <aside class="fixed top-0 left-0 h-full w-64 bg-gray-800 shadow-md p-6 hidden md:flex flex-col">
    <h2 class="text-2xl font-bold mb-8 text-indigo-400">Hello, <%= user.name %>!</h2>
    <nav class="flex flex-col gap-4 text-gray-200">
      <a href="/" class="block px-3 py-2 rounded hover:bg-indigo-600 hover:text-white font-medium transition">Home</a>
      <%- include("../partials/sidebars/employer.ejs") %>
    </nav>
  </aside>

  <!-- Main Content + Footer wrapper -->
  <div class="flex-1 flex flex-col md:ml-64 min-h-screen">

    <!-- Main Content -->
    <main class="flex-grow flex flex-col p-6 md:p-10 space-y-10">

      <h2 class="text-2xl font-bold text-indigo-400 mb-4">Company Info</h2>

      <div class="bg-gray-800 p-4 rounded-lg shadow-md space-y-2">
        <p><strong>Name:</strong> <%= company.name %></p>
        <p><strong>Email:</strong> <%= company.email %></p>
        <% if (company.phone) { %>
          <p><strong>Phone:</strong> <%= company.phone %></p>
        <% } %>
        <% if (company.website) { %>
          <p><strong>Website:</strong> <a href="<%= company.website %>" target="_blank" class="text-indigo-400 hover:underline"><%= company.website %></a></p>
        <% } %>
        <% if (company.location) { %>
          <p><strong>Location:</strong> <%= company.location %></p>
        <% } %>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-3 mt-4">
        <a href="/employer/profile/edit" class="bg-green-500 hover:bg-green-600 px-4 py-2 rounded text-white font-semibold transition">Edit Profile</a>
        <a href="/employer/my-jobs" class="bg-blue-500 hover:bg-blue-600 px-4 py-2 rounded text-white font-semibold transition">My Jobs</a>
        <a href="/employer/applicants" class="bg-gray-600 hover:bg-gray-700 px-4 py-2 rounded text-white font-semibold transition">Applicants</a>
      </div>

      <!-- Company Stats -->
      <h2 class="text-2xl font-bold text-indigo-400 mt-8 mb-4">Company Stats</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-gray-800 p-4 rounded-lg text-center shadow-md">
          <h5 class="text-gray-400">Total Jobs</h5>
          <h2 class="text-3xl font-bold text-indigo-400 mt-2"><%= stats.totalJobs %></h2>
        </div>
        <div class="bg-gray-800 p-4 rounded-lg text-center shadow-md">
          <h5 class="text-gray-400">Total Applications</h5>
          <h2 class="text-3xl font-bold text-indigo-400 mt-2"><%= stats.totalApplications %></h2>
        </div>
        <div class="bg-gray-800 p-4 rounded-lg text-center shadow-md">
          <h5 class="text-gray-400">Hired</h5>
          <h2 class="text-3xl font-bold text-indigo-400 mt-2"><%= stats.hired %></h2>
        </div>
        <!-- Add more stat cards if needed -->
      </div>

    </main>

    <!-- Footer (sticky like other pages) -->
    <%- include("../partials/footer.ejs") %>

  </div>
</div>

</body>
</html>
