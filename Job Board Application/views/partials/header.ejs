<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Board Application</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com/4.1.18"></script>
  <script>
    // Safelist dynamic classes for Tailwind CDN
    tailwind.config = {
      safelist: [
        'bg-gray-900', 'bg-gray-800', 'text-gray-100', 'text-gray-200', 
        'text-indigo-400', 'hover:bg-indigo-600', 'hover:text-white',
        'rounded-xl', 'rounded-lg', 'shadow-md', 'shadow-lg', 'flex', 
        'hidden', 'md:flex', 'md:hidden', 'md:ml-64', 'p-6', 'p-8', 
        'p-10', 'space-y-12', 'gap-4', 'gap-6'
      ]
    }
  </script>
</head>
<body class="bg-gray-900 text-gray-100">

<header class="bg-gray-900 text-gray-100 shadow-md">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="text-2xl font-bold text-indigo-400 hover:text-indigo-300 transition">
      JobBoard
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-6 font-medium">
      <a href="/jobs" class="hover:text-indigo-300 transition">Jobs</a>
      <a href="/about" class="hover:text-indigo-300 transition">About</a>

      <% if (!user) { %>
        <a href="/login" class="px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-500 transition">Login</a>
        <a href="/register" class="px-4 py-2 border border-indigo-600 text-indigo-400 rounded-lg hover:bg-indigo-800 transition">Sign Up</a>
      <% } else { %>
        <span class="text-gray-200 font-semibold">Hello, <%= user.name %></span>
        <a href="/logout" class="px-4 py-2 bg-red-600 text-white rounded-lg shadow hover:bg-red-500 transition">Logout</a>
      <% } %>
    </div>

    <!-- Mobile Menu Button -->
    <div class="md:hidden flex items-center">
      <button id="mobile-menu-button" class="text-gray-100 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-gray-800 shadow-md">
    <div class="px-6 py-4 flex flex-col gap-4 font-medium">
      <a href="/jobs" class="hover:text-indigo-300 transition">Jobs</a>
      <a href="/about" class="hover:text-indigo-300 transition">About</a>

      <% if (!user) { %>
        <a href="/login" class="px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-500 transition">Login</a>
        <a href="/register" class="px-4 py-2 border border-indigo-600 text-indigo-400 rounded-lg hover:bg-indigo-700 transition">Sign Up</a>
      <% } else { %>
        <span class="text-gray-200 font-semibold">Hello, <%= user.name %></span>
        <a href="/logout" class="px-4 py-2 bg-red-600 text-white rounded-lg shadow hover:bg-red-500 transition">Logout</a>
      <% } %>
    </div>
  </div>
</header>

<script>
  // Toggle mobile menu
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn.addEventListener('click', () => {
    menu.classList.toggle('hidden');
  });
</script>
