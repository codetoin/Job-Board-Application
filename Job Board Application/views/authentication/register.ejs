<%- include("../partials/head.ejs") %>
<body class="bg-gray-900 text-gray-100">

<%- include("../partials/header.ejs") %>

<div class="min-h-screen flex items-center justify-center px-4">

  <div class="w-full max-w-lg bg-gray-800 rounded-2xl shadow-xl p-8 space-y-6">

    <!-- Title -->
    <div class="text-center space-y-2">
      <h1 class="text-3xl font-extrabold text-indigo-400">Create Account</h1>
      <p class="text-gray-400 text-sm">
        Join our job portal and start your journey
      </p>
    </div>

    <!-- Register Form (LOGIC UNCHANGED) -->
    <form action="/register" method="post" class="space-y-5">

      <!-- Name -->
      <div class="space-y-1">
        <label for="name" class="block text-sm font-medium text-gray-300">
          Name
        </label>
        <input
          type="text"
          id="name"
          name="username"
          required
          class="w-full px-4 py-2 rounded-lg bg-gray-900 text-gray-100
                 border border-gray-700 focus:outline-none
                 focus:ring-2 focus:ring-indigo-500"
        />
      </div>

      <!-- Role -->
      <div class="space-y-1">
        <label for="role" class="block text-sm font-medium text-gray-300">
          Role
        </label>
        <select
          name="role"
          id="role"
          required
          class="w-full px-4 py-2 rounded-lg bg-gray-900 text-gray-100
                 border border-gray-700 focus:outline-none
                 focus:ring-2 focus:ring-indigo-500"
        >
          <option value="jobseeker">Job Seeker</option>
          <option value="employer">Employer</option>
        </select>
      </div>

      <!-- Email -->
      <div class="space-y-1">
        <label for="email" class="block text-sm font-medium text-gray-300">
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-2 rounded-lg bg-gray-900 text-gray-100
                 border border-gray-700 focus:outline-none
                 focus:ring-2 focus:ring-indigo-500"
        />
      </div>

      <!-- Password -->
      <div class="space-y-1">
        <label for="password" class="block text-sm font-medium text-gray-300">
          Password
        </label>
        <input
          type="password"
          id="password"
          name="password"
          required
          class="w-full px-4 py-2 rounded-lg bg-gray-900 text-gray-100
                 border border-gray-700 focus:outline-none
                 focus:ring-2 focus:ring-indigo-500"
        />
      </div>

      <!-- Confirm Password -->
      <div class="space-y-1">
        <label for="confirmPassword" class="block text-sm font-medium text-gray-300">
          Confirm Password
        </label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          required
          class="w-full px-4 py-2 rounded-lg bg-gray-900 text-gray-100
                 border border-gray-700 focus:outline-none
                 focus:ring-2 focus:ring-indigo-500"
        />
      </div>

      <!-- Submit -->
      <button
        type="submit"
        class="w-full py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500
               transition font-semibold text-white shadow-md"
      >
        Register
      </button>

    </form>

    <!-- Footer Links -->
    <div class="text-center text-sm text-gray-400">
      Already have an account?
      <a href="/login" class="text-indigo-400 hover:text-indigo-300 transition">
        Login
      </a>
    </div>

  </div>
</div>

<%- include("../partials/footer.ejs") %>
</body>
